# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# 本地运行数据（含人脸照片等隐私内容，整个 data 目录都不入库）
# 只放行各子目录的占位文件；data 下任何截图/导出文件都不会被误提交
data/*
!data/faces/.gitkeep
!data/embeddings/.gitkeep
!data/attendance/.gitkeep
!data/logs/.gitkeep
!data/faces/.gitkeep
!data/embeddings/.gitkeep
!data/attendance/.gitkeep
!data/logs/.gitkeep

# 模型文件（运行时自动下载，不入库）
models/*
!models/.gitkeep

# 临时文件
*.mp4
*.tmp

# 测试覆盖率数据
.coverage
coverage.xml
htmlcov/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# 本地运行数据（注册照片、特征库、签到记录、日志不入库）
data/faces/*
data/embeddings/*
data/attendance/*
data/logs/*
!data/faces/.gitkeep
!data/embeddings/.gitkeep
!data/attendance/.gitkeep
!data/logs/.gitkeep

# 模型文件（运行时自动下载，不入库）
models/*
!models/.gitkeep

# 临时文件
*.mp4
*.tmp

# 测试覆盖率数据
.coverage
coverage.xml
htmlcov/
